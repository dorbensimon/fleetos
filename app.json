{
  "expo": {
    "name": "fleetos",
    "slug": "fleetos",
    "version": "1.0.0",
    "scheme": "fleetos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tolvex.fleetos",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "fleetos",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tolvex.fleetos",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "האפליקציה צריכה גישה לתמונות כדי להעלות מסמכי חברה ותמונות.",
          "cameraPermission": "האפליקציה צריכה גישה למצלמה כדי לצלם מסמכים לחתימה."
        }
      ],
      "expo-font",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8db233d7-e6e0-4698-a339-c9114f3b5470"
      }
    },
    "owner": "dor5995"
  }
}

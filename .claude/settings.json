{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Write(.claude/*-findings.md)",
      "Edit(.claude/*-findings.md)",
      "Write(.claude/*-backlog.md)",
      "Edit(.claude/*-backlog.md)",
      "Write(.claude/*-summary-for-team.md)",
      "Edit(.claude/*-summary-for-team.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/dor59/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/dor59/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/rewrite-noisy-bash.js"
          }
        ]
      }
    ]
  }
}